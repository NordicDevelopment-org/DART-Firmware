#ifndef _VARIANT_NDI_1W_
#define _VARIANT_NDI_1W_

/** Master clock frequency */
#define VARIANT_MCK (64000000ul)

// 32.768 kHz crystal Y2 on P0.00 / P0.01 (netlist U1 balls D2, F2)
#define USE_LFXO

/*----------------------------------------------------------------------------
 *        Headers
 *----------------------------------------------------------------------------*/

#include "WVariant.h"

#ifdef __cplusplus
extern "C" {
#endif // __cplusplus

// Number of pins defined in PinDescription array
#define PINS_COUNT (48)
#define NUM_DIGITAL_PINS (48)
#define NUM_ANALOG_INPUTS (6)
#define NUM_ANALOG_OUTPUTS (0)

@@PIN_MACROS@@

/*
 * Analog pins (Arduino core names). A0 is the battery tap (stock BATTERY_PIN); A1 to A5 follow the NDI taps.
 */
@@ANALOG_NAMES@@
#define PIN_A6 (0xff)
#define PIN_A7 (0xff)

static const uint8_t A0 = PIN_A0;
static const uint8_t A1 = PIN_A1;
static const uint8_t A2 = PIN_A2;
static const uint8_t A3 = PIN_A3;
static const uint8_t A4 = PIN_A4;
static const uint8_t A5 = PIN_A5;
static const uint8_t A6 = PIN_A6;
static const uint8_t A7 = PIN_A7;
#define ADC_RESOLUTION 14

/*
 * SPI: the SX1262 only. No second SPI bus, no external flash, no display on this board.
 */
#define SPI_INTERFACES_COUNT 1

@@SPI_CONSTS@@

/*
 * Wire: one I2C bus (MAX17048 0x36, BQ25856-Q1 0x6B, Qwiic port behind a TCA4307).
 */
#define WIRE_INTERFACES_COUNT 1

#ifdef __cplusplus
}
#endif

#include "ndi_config.h"

#endif
